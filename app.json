{
  "expo": {
    "name": "Fabricator",
    "slug": "fabricator",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "jsEngine": "jsc",

    "icon": "./assets/AppLogo.png",

    "splash": {
      "image": "./assets/fabricator-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hsparks.fabricator",
      "buildNumber": "25",

      "icon": "./assets/AppLogo.png",

      "infoPlist": {
        "NSCameraUsageDescription": "Fabricator uses the camera to document build progress.",
        "NSPhotoLibraryUsageDescription": "Fabricator stores project photos for build tracking.",
        "NSMicrophoneUsageDescription": "Fabricator uses the microphone for garage voice notes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.hsparks.fabricator",

      "adaptiveIcon": {
        "foregroundImage": "./assets/AppLogo.png",
        "backgroundColor": "#121212"
      }
    },

    "web": {
      "bundler": "metro"
    },

    "extra": {
      "eas": {
        "projectId": "5153d72f-8e6b-41e6-a152-91301638ca0e"
      }
    },

    "plugins": [
      "expo-font"
    ]
  }
}
