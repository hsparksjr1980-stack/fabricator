# Supabase Configuration
# Get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# API Configuration (optional; leave blank unless approved)
EXPO_PUBLIC_API_URL=

# Analytics (optional; disabled until explicitly approved)
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Feature Flags (optional; production AI is disabled until explicitly approved)
EXPO_PUBLIC_FEATURE_AI_SUMMARIES=false
EXPO_PUBLIC_FEATURE_GALLERY=true
